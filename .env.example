# Optional private S3 configuration for Docker Compose.
S3_BUCKET=
AWS_DEFAULT_REGION=
S3_ENDPOINT_URL=

# Optional vision extraction configuration.
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

WORKSPACE_TIMEZONE=Asia/Kolkata

# Local development. Use the staging HTTPS origin and secure cookies for a pilot.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_COOKIE_SECURE=false
